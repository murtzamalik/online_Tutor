{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice_summary",
  "title": "voice_summary",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary_md": {
          "type": "string"
        },
        "topics_covered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "summary_md",
        "topics_covered",
        "strengths",
        "next_steps"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}