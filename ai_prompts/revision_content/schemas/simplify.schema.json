{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simplify",
  "title": "simplify",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simplified_md": {
          "type": "string"
        },
        "terms_kept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reading_level_note": {
          "type": "string"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "simplified_md",
        "terms_kept",
        "reading_level_note"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}