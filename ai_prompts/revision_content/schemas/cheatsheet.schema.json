{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cheatsheet",
  "title": "cheatsheet",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic_ref": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "heading",
              "bullets"
            ]
          }
        },
        "key_equations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command_word_tips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "topic_ref",
        "title",
        "blocks",
        "key_equations",
        "command_word_tips"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}