{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worked_example",
  "title": "worked_example",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step_no": {
                "type": "integer"
              },
              "action": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              }
            },
            "required": [
              "step_no",
              "action",
              "explanation"
            ]
          }
        },
        "similar_but_different": {
          "type": "boolean"
        },
        "final_line": {
          "type": "string"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "title",
        "steps",
        "similar_but_different",
        "final_line"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}