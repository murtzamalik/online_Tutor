{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hint",
  "title": "hint",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "integer"
        },
        "hint_text": {
          "type": "string"
        },
        "reveals_final_answer": {
          "type": "boolean"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "level",
        "hint_text",
        "reveals_final_answer"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}