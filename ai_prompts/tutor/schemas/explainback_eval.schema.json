{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explainback_eval",
  "title": "explainback_eval",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "covered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misconceptions_seen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "SECURE",
            "PARTIAL",
            "NOT_YET"
          ]
        },
        "feedback_text": {
          "type": "string"
        },
        "follow_up_prompt": {
          "type": "string"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "covered",
        "missing",
        "misconceptions_seen",
        "verdict",
        "feedback_text",
        "follow_up_prompt"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}