{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan_rationale",
  "title": "plan_rationale",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "item_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "item_id",
              "why"
            ]
          }
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "summary",
        "item_notes"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}