{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "class_insight",
  "title": "class_insight",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string"
              },
              "observation": {
                "type": "string"
              },
              "suggested_teaching_move": {
                "type": "string"
              }
            },
            "required": [
              "topic",
              "observation",
              "suggested_teaching_move"
            ]
          }
        },
        "pupils_to_check_in": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pupil_token": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "pupil_token",
              "reason"
            ]
          }
        },
        "used_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "headline",
        "patterns",
        "pupils_to_check_in",
        "used_fact_ids"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}