{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_narrative",
  "title": "report_narrative",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "focus_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_parent_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "headline",
        "paragraphs",
        "wins",
        "focus_areas",
        "suggested_parent_actions",
        "used_fact_ids"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}