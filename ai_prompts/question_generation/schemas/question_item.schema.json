{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question_item",
  "title": "question_item",
  "oneOf": [
    {
      "required": [
        "status",
        "blueprint_id",
        "question_type",
        "command_word",
        "marks",
        "context_text",
        "question_text",
        "options",
        "answer_format",
        "mark_scheme",
        "model_answer",
        "common_errors",
        "diagram_request",
        "grounding",
        "self_estimate"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "blueprint_id": {
          "type": "string"
        },
        "question_type": {
          "type": "string",
          "enum": [
            "MULTIPLE_CHOICE",
            "SHORT_ANSWER",
            "CALCULATION",
            "EXTENDED_WRITTEN",
            "PRACTICAL_BASED"
          ]
        },
        "command_word": {
          "type": "string"
        },
        "marks": {
          "type": "integer",
          "minimum": 1
        },
        "context_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_text": {
          "type": "string"
        },
        "options": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "text",
                  "correct",
                  "misconception"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "correct": {
                    "type": "boolean"
                  },
                  "misconception": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "answer_format": {
          "type": "string",
          "enum": [
            "TEXT",
            "NUMBER",
            "EQUATION",
            "MCQ"
          ]
        },
        "mark_scheme": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme_type",
            "marking_points",
            "levels",
            "indicative_content",
            "marking_notes"
          ],
          "properties": {
            "scheme_type": {
              "type": "string",
              "enum": [
                "POINTS",
                "LEVELS"
              ]
            },
            "marking_points": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "marks",
                  "point",
                  "accept",
                  "reject",
                  "ignore"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^M[0-9]+$"
                  },
                  "marks": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "point": {
                    "type": "string"
                  },
                  "accept": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reject": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ignore": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "levels": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "mark_min",
                  "mark_max",
                  "descriptor"
                ],
                "properties": {
                  "level": {
                    "type": "integer"
                  },
                  "mark_min": {
                    "type": "integer"
                  },
                  "mark_max": {
                    "type": "integer"
                  },
                  "descriptor": {
                    "type": "string"
                  }
                }
              }
            },
            "indicative_content": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "marking_notes": {
              "type": "string"
            }
          }
        },
        "model_answer": {
          "type": "string"
        },
        "common_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer",
              "marks_awarded",
              "why"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "marks_awarded": {
                "type": "integer",
                "minimum": 0
              },
              "why": {
                "type": "string"
              }
            }
          },
          "minItems": 2,
          "maxItems": 4
        },
        "diagram_request": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "library_id",
                "labels"
              ],
              "properties": {
                "kind": {
                  "const": "LIBRARY"
                },
                "library_id": {
                  "type": "string"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "chart_type",
                "x_label",
                "y_label",
                "data_source"
              ],
              "properties": {
                "kind": {
                  "const": "CHART"
                },
                "chart_type": {
                  "type": "string",
                  "enum": [
                    "LINE",
                    "SCATTER",
                    "BAR",
                    "TABLE"
                  ]
                },
                "x_label": {
                  "type": "string"
                },
                "y_label": {
                  "type": "string"
                },
                "data_source": {
                  "type": "string",
                  "description": "'template_variables' for calc items, otherwise 'inline'"
                },
                "inline_data": {
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "grounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exemplar_ids",
            "spec_phrases"
          ],
          "properties": {
            "exemplar_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "spec_phrases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "self_estimate": {
          "type": "object",
          "required": [
            "difficulty_grade_band",
            "time_seconds"
          ],
          "properties": {
            "difficulty_grade_band": {
              "type": "string",
              "pattern": "^[1-9]-[1-9]$",
              "description": "grade band e.g. 4-5"
            },
            "time_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1200
            }
          },
          "additionalProperties": false
        },
        "repair_log": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}