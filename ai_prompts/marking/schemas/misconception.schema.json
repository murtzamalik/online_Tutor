{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "misconception",
  "title": "misconception",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "misconception_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "evidence": {
          "type": "string"
        },
        "is_new": {
          "type": "boolean"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "misconception_id",
        "label",
        "confidence",
        "evidence",
        "is_new"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "cannot_complete"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}