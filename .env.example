# Secrets — never commit real values. Copy to `.env` for local use.
COMPOSE_PROJECT_NAME=studyloop

POSTGRES_DB=studyloop
POSTGRES_USER=studyloop_owner
POSTGRES_PASSWORD=local_owner_change_me

# Application DB roles (LOGIN wrappers; NOLOGIN roles created in V011)
TUTOR_APP_PASSWORD=local_app_change_me
TUTOR_GATEWAY_PASSWORD=local_gateway_change_me

JWT_SECRET=local_dev_jwt_secret_must_be_at_least_32_chars_long
AES_DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service-to-service
GATEWAY_SERVICE_TOKEN=local_gateway_service_token_change_me
CORE_API_SERVICE_TOKEN=local_core_service_token_change_me

AI_GATEWAY_STUB=true
EMBEDDING_STUB=true

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_change_me

MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025

# Stripe test mode (optional — FakePaymentProvider used when blank; never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URLs (Caddy)
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080/api/v1
